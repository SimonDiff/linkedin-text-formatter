{
  "manifest_version": 3,
  "name": "LinkedIn DiffStyle",
  "version": "0.3.1",
  "description": "Bold, italic, lists and more for LinkedIn posts, comments and messages, plus an always-visible character counter.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "js": [
        "src/config.js",
        "src/unicode.js",
        "src/editor.js",
        "src/toolbar.js",
        "src/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
